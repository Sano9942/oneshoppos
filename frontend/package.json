{
  "name": "sanopos-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-meta.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "parity:audit": "node ../tools/api-parity-audit.js --format both",
    "parity:check:frontend-only": "node ../tools/api-parity-audit.js --format both --fail-on frontend-only",
    "parity:check:unclassified": "node ../tools/api-parity-audit.js --format both --fail-on unclassified",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test tests/smoke",
    "test:smoke:headed": "npx playwright test tests/smoke --headed",
    "test:smoke:storefront": "npx playwright test tests/smoke/storefront-public.smoke.spec.js",
    "test:smoke:phase5": "npx playwright test tests/smoke/phase5-pakistan.smoke.spec.js",
    "typecheck": "tsc --noEmit",
    "lint:baseline": "node scripts/lint-baseline.mjs",
    "lint:baseline:update": "node scripts/lint-baseline.mjs --update"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@sentry/react": "^10.46.0",
    "@vercel/functions": "^3.7.5",
    "idb": "^8.0.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.575.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
