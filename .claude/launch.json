{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "index.js"
      ],
      "cwd": "backend",
      "port": 5000
    },
    {
      "name": "backend-5001",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "index.js"
      ],
      "cwd": "backend",
      "env": {
        "PORT": "5001",
        "CORS_ORIGIN": "http://localhost:5173,http://localhost:5174"
      },
      "port": 5001
    },
    {
      "name": "frontend-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "cwd": "frontend",
      "env": {
        "VITE_API_BASE": "http://localhost:5001"
      },
      "port": 5174
    },
    {
      "name": "backend-5002",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "index.js"
      ],
      "cwd": "backend",
      "env": {
        "PORT": "5002",
        "CORS_ORIGIN": "http://localhost:5175"
      },
      "port": 5002
    },
    {
      "name": "frontend-5175",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "cwd": "frontend",
      "env": {
        "VITE_API_BASE": "http://localhost:5002"
      },
      "port": 5175
    }
  ]
}
