# Dependencies - never read these
node_modules/
backend/node_modules/
frontend/node_modules/

# Built output - generated, not source
frontend/dist/

# Archived docs - completed plans, not active
docs/archive/

# Database files - binary, not readable
backend/backups/
*.db
*.db-shm
*.db-wal

# Generated report exports - not source code
backend/exports/

# Lock files - too large, not useful to Claude
backend/package-lock.json
frontend/package-lock.json

# Old migration files — only read migrate61.js (the latest)
backend/migrate.js
backend/migrate[0-9].js
backend/migrate[1-5][0-9].js
backend/migrate60.js

# Test files - not needed for development tasks
frontend/tests/
backend/e2e_full_test.js
backend/e2e_test.js
backend/api_test.js
backend/reports_phase2_test.js
backend/shopify_mock_integration_test.js
backend/tier4_smoke_test.js

# Diagnostic / utility scripts - one-off tools, not source code
backend/check_counts_v3.js
backend/check_sync.js
backend/diagnose_routes.js
backend/dumpDb.js
backend/dumpDb2.js
backend/health_check.js
backend/inspect_schema.js
backend/preflight.js

# Temp / scratch folders
tmp/
