# Copy this file to backend/.env when you are ready to connect a real Shopify store.
# Do not commit real secrets.

# Server
PORT=5000

# Shopify crypto key for encrypting stored connection secrets (32-byte base64/hex/plain accepted)
SHOPIFY_SECRET_KEY=replace_with_a_strong_secret_key

# Optional: max retry attempts for outbound inventory queue
SHOPIFY_MAX_RETRY_ATTEMPTS=5

# Optional: disable background worker in local/dev if needed (1 = disable)
SHOPIFY_SYNC_WORKER_DISABLED=0

# Public base URL used for webhook setup callback generation
# Example: https://pos.yourdomain.com
APP_PUBLIC_BASE_URL=http://localhost:5000

