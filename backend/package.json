{
  "name": "sanopos-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "dev:prod": "node scripts/dev-prod.js",
    "preflight": "node preflight.js",
    "parity:audit": "node ../tools/api-parity-audit.js --format both",
    "parity:check:frontend-only": "node ../tools/api-parity-audit.js --format both --fail-on frontend-only",
    "parity:check:unclassified": "node ../tools/api-parity-audit.js --format both --fail-on unclassified",
    "parity:sync-registry": "node ../tools/api-parity-audit.js --format both --sync-registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/integration/smoke-gate.test.js",
    "test:coverage": "vitest run tests/unit --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@sentry/node": "^10.46.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-thermal-printer": "^4.6.0",
    "nodemailer": "^8.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.20.0",
    "pg-boss": "^12.15.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
