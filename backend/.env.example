# SanoPOS Backend Environment Variables
# Copy this file to .env and fill in values. Never commit .env to git.

# Server
PORT=5000
NODE_ENV=development

# Multi-tenant mode
# 0 = single-tenant (default) — uses singleton sanopos.db, x-employee-id header auth, plaintext PIN fallback
# 1 = multi-tenant — JWT auth active, tenant lookup via Store Code in master.db, bcrypt PIN required
MULTI_TENANT=0

# JWT Secrets (required when MULTI_TENANT=1)
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# JWT Token Lifetimes (optional — defaults shown)
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Data directory (production: Railway persistent volume mount)
# DATA_DIR=/data

# CORS origin (production: Vercel frontend URL)
# CORS_ORIGIN=https://sanopos.vercel.app

# Cloudflare R2 Backups (optional — only needed for automated backups)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sanopos-backups

# Shopify Integration (optional — only needed if Shopify sync is used)
SHOPIFY_SECRET_KEY=

# Rate Limiting (optional — defaults shown)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WEBHOOK_MAX=120
SHOPIFY_MAX_RETRY_ATTEMPTS=5
